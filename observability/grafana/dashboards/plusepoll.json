{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A" }],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[5m]))", "legendFormat": "4xx", "refId": "A" },
        { "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "B" }
      ],
      "title": "HTTP errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "B" }
      ],
      "title": "HTTP latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}", "refId": "A" }],
      "title": "Process resident memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 9,
      "targets": [{
        "expr": "sum by (job) (rate(process_cpu_user_seconds_total[5m]) + rate(process_cpu_system_seconds_total[5m]))",
        "legendFormat": "{{job}}",
        "refId": "A"
      }],
      "title": "Node.js CPU cores in use",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 5,
      "targets": [
        { "expr": "sum(rate(kafka_messages_processed_total[5m]))", "legendFormat": "processed votes/s", "refId": "A" },
        { "expr": "sum(rate(kafka_processing_failures_total[5m]))", "legendFormat": "failures/s", "refId": "B" },
        { "expr": "sum(rate(dead_letter_messages_total[5m]))", "legendFormat": "DLQ/s", "refId": "C" }
      ],
      "title": "Kafka vote processing",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 6,
      "targets": [
        { "expr": "sum(rate(duplicate_votes_rejected_total[5m]))", "legendFormat": "duplicate votes/s", "refId": "A" },
        { "expr": "sum(rate(postgres_operation_errors_total[5m]))", "legendFormat": "PostgreSQL errors/s", "refId": "B" }
      ],
      "title": "Duplicates and database errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 7,
      "targets": [{
        "expr": "100 * sum(rate(redis_cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(redis_cache_operations_total{result=~\"hit|miss\"}[5m])), 0.000001)",
        "legendFormat": "cache hit %",
        "refId": "A"
      }],
      "title": "Poll-list Redis cache hit ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "id": 8,
      "targets": [{ "expr": "{service=~\".*(poll-api|vote-worker).*\"} | json | level=~\"error|fatal\"", "refId": "A" }],
      "title": "API and worker errors",
      "type": "logs"
    }
  ],
  "schemaVersion": 41,
  "tags": ["plusepoll", "api", "kafka"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "PlusePoll Operations",
  "uid": "plusepoll-ops",
  "version": 1
}
