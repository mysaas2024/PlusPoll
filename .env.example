# Local development only. Replace all placeholder credentials before deployment.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
JWT_SECRET=replace-this-with-a-long-random-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-grafana-password

POSTGRES_USER=plusepoll
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=plusepoll
DATABASE_URL=postgresql://plusepoll:replace-this-local-password@localhost:5432/plusepoll?schema=public

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://plusepoll:replace-this-rabbitmq-password@localhost:5672
RABBITMQ_USER=plusepoll
RABBITMQ_PASSWORD=replace-this-rabbitmq-password
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=plusepoll-api
KAFKA_WORKER_CLIENT_ID=plusepoll-vote-worker
KAFKA_VOTE_TOPIC=poll.votes
KAFKA_VOTE_DLQ_TOPIC=poll.votes.dlq
KAFKA_VOTE_GROUP_ID=plusepoll-vote-workers
POLL_CACHE_TTL_SECONDS=15
HEALTH_CHECK_TIMEOUT_MS=2000
